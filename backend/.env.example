DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/invoice_db
# 文字识别线路（qwen3.5-ocr）必需：通义千问 / 阿里云百炼（DashScope）API Key。
# 没有它就不会运行文字识别，只剩视觉模型一路。
QWEN_API_KEY=your_dashscope_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Optional: require token to configure LLM via API
LLM_CONFIG_TOKEN=
DEBUG=true
